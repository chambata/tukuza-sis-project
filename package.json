{
  "name": "tukuza-sis-project",
  "version": "0.1.0",
  "description": "FPC Student Information Management System (Tukuza SIS) - Electron desktop app",
  "author": "Chambata Alex Nkatwe <cnkatwe@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "import-data": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/importFromExcel.js",
    "import-data:node": "node server/importFromExcel.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dev": "concurrently -k -n CLIENT,ELECTRON -c cyan,magenta \"npm run client:dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run client:build && electron-builder",
    "postinstall": "npm --prefix client install && electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.fpc.tukuzasis",
    "productName": "Tukuza SIS",
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "!server/data/*.xlsm"
    ],
    "extraResources": [
      { "from": "server/data", "to": "data" }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
